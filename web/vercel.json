{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/pilares/", "destination": "/sobre-mi/#enfoque", "permanent": true },
    { "source": "/index.php/politica-privacidad/", "destination": "/politica-privacidad/", "permanent": true },
    { "source": "/mas-informacion-sobre-las-cookies/", "destination": "/politica-de-cookies/", "permanent": true },
    { "source": "/hola-mundo/", "destination": "/", "permanent": true },
    { "source": "/feed/", "destination": "/", "permanent": true },
    { "source": "/comments/feed/", "destination": "/", "permanent": true },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": false },
    { "source": "/wp-login.php", "destination": "/", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
